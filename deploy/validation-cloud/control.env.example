VALIDATION_CLOUD_TOKEN=replace-with-at-least-24-random-characters
VALIDATION_CLOUD_HOST=127.0.0.1
VALIDATION_CLOUD_PORT=8787
VALIDATION_CLOUD_DATA_DIR=/var/lib/vcoder-validation
VALIDATION_CLOUD_EXECUTOR=vcoder-docker
# Replace with the exact digest printed by docker image inspect after the target-arch build.
VALIDATION_CLOUD_RUNNER_IMAGE=vcoder-validation-runner@sha256:replace-with-image-digest
VALIDATION_CLOUD_RUNNER_ENV_FILE=/etc/vcoder-validation/runner.env
VALIDATION_CLOUD_REPOSITORY_HOSTS=github.com
